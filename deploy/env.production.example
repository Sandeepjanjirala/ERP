# EduNexa production settings. Copy to deploy/.env on the server, fill in every value, and keep
# it private (chmod 600). deploy/.env is ignored by Git: never commit it.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(60))"

# The address people open. Point its DNS A/AAAA record at the server first.
SITE_DOMAIN=school.example.com
SITE_URL=https://school.example.com
ALLOWED_HOSTS=school.example.com
CSRF_TRUSTED_ORIGINS=https://school.example.com
# An email address: Caddy gets a Let's Encrypt certificate (expiry notices go there).
CADDY_TLS=it-admin@school.example.com

DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Email for password resets, notices and receipts (your provider's SMTP details).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=School name <noreply@school.example.com>
# Optional: who gets an email for every server error.
ERROR_EMAILS=

# Optional. Razorpay TEST keys only (rzp_test_...); without them the Sandbox takes test payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional tuning.
WEB_CONCURRENCY=3
WORKER_CONCURRENCY=2
LEAVER_GRACE_DAYS=30
LEAVER_FEES_GRACE_DAYS=90
