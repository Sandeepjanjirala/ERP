# Copy to .env and replace these values. setup_local.py generates a local file.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For local Python without Docker, leave DATABASE_URL empty to use SQLite.
DATABASE_URL=
# Docker compose uses the following PostgreSQL password:
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Production: DEBUG=0, real hosts and HTTPS origins, external PostgreSQL.
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=School office <noreply@example.com>
