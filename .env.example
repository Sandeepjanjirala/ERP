# Copy to .env and replace these values. setup_local.py generates a local file.
# The environment is chosen by DJANGO_SETTINGS_MODULE (config.settings.dev, .prod or .test),
# not by a DEBUG variable: manage.py defaults to dev and the WSGI server to prod.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For local Python without Docker, leave DATABASE_URL empty to use SQLite.
DATABASE_URL=
# Docker compose uses the following PostgreSQL password:
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Production: real hosts and HTTPS origins, external PostgreSQL.
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=EduNexa <noreply@example.com>
